    {
      "id": 4,
      "module": "datastore:AddRecord",
      "version": 1,
      "parameters": {
        "datastore": 242031
      },
      "filter": {
        "name": "Actionable requests only",
        "conditions": [
          [
            {
              "a": "{{2.jsonResponse.classification}}",
              "b": "actionable",
              "o": "text:equal"
            }
          ]
        ]
      },
      "mapper": {
        "key": "{{uuid}}",
        "data": {
          "status": "pending",
          "decision": "pending",
          "created_at": "{{formatDate(now; \"YYYY-MM-DDTHH:mm:ssZ\")}}",
          "request_id": "{{2.jsonResponse.summary}}"
        },
        "overwrite": false
      },
      "metadata": {
        "designer": {
          "x": -8,
          "y": -223,
          "name": "Create one-time approval token"
        }
      }
    },
    {
      "id": 3,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 12616909
      },
      "filter": {
        "name": "Actionable requests only",
        "conditions": [
          [
            {
              "a": "{{2.jsonResponse.classification}}",
              "b": "actionable",
              "o": "text:equal"
            }
          ]
        ]
      },
      "mapper": {
        "to": [
          "REPLACE_WITH_APPROVER_EMAIL"
        ],
        "content": "<h2>Change request awaiting your decision</h2><p><strong>Summary:</strong> {{2.jsonResponse.summary}}</p><p><strong>Priority:</strong> {{2.jsonResponse.priority}}</p><p><strong>Component:</strong> {{2.jsonResponse.component}}</p><p><strong>Category:</strong> {{2.jsonResponse.category}}</p><p><strong>Details:</strong><br>{{2.jsonResponse.detailed_description}}</p><p><strong>Acceptance criteria:</strong><br>{{join(2.jsonResponse.acceptance_criteria; \"<br>\")}}</p><p><strong>Duplicate notes:</strong> {{2.jsonResponse.duplicate_notes}}</p><hr><p><a href=\"REPLACE_WITH_APPROVAL_HANDLER_WEBHOOK_URL?token={{encodeURL(4.key)}}&decision=approve\">APPROVE</a></p><p><a href=\"REPLACE_WITH_APPROVAL_HANDLER_WEBHOOK_URL?token={{encodeURL(4.key)}}&decision=reject\">REJECT</a></p><p>Each token is intended for one decision only.</p>",
        "subject": "Change request approval: {{2.jsonResponse.summary}}",
        "bodyType": "rawHtml"
      },
      "metadata": {
        "designer": {
          "x": -288,
          "y": 61,
          "name": "Email approval request"
        }
      }
